msgid "ميزانية الذكاء الاصطناعي لهذا الشهر"
msgstr "इस महीने का AI बजट"

msgid ""
"نظرة شاملة على الشركات المشتركة، واستهلاك الذكاء الاصطناعي وتكلفته، وصحة "
"الخدمات."
msgstr "सदस्य कंपनियों, AI उपयोग और लागत, और सेवाओं की स्थिति का समग्र अवलोकन।"

msgid "نقل"
msgstr "स्थानांतरित करें"

msgid "نقل إلى مشغّل"
msgstr "ऑपरेटर को स्थानांतरित करें"

msgid "نقل الشركة إلى مشغّل آخر؟"
msgstr "कंपनी को दूसरे ऑपरेटर के पास ले जाएँ?"

msgid "هذا آخر مشرف نظام فلا يُحذف."
msgstr "यह अंतिम सिस्टम एडमिन है, इसलिए इसे हटाया नहीं जा सकता।"

msgid "ورقة في المكتبة"
msgstr "लाइब्रेरी में दस्तावेज़"

msgid "يزيد حسب الصفحات"
msgstr "पेजों के साथ बढ़ता है"

msgid "يستطيع %(email)s الدخول من جديد."
msgstr "%(email)s फिर से साइन इन कर सकता है।"

msgid "يملك:"
msgstr "मालिक:"

msgid "ينتهي اشتراك الشركة بعد %(n)s يوماً."
msgstr "कंपनी की सदस्यता %(n)s दिन में समाप्त होगी।"

msgid ""
"— نبذة النشاط والجمهور والأسلوب والهوية البصرية، ليكتب وكيل محتوى يشبه "
"علامتك."
msgstr ""
"— व्यवसाय का सार, दर्शक, शैली और विज़ुअल पहचान, ताकि वकील आपके ब्रांड जैसा कंटेंट लिखे।"

msgid "Your company is now served and billed by %(operator)s"
msgstr "आपकी कंपनी को अब %(operator)s सेवा देता और बिल करता है"

msgid "عمل شركتك في مكان واحد"
msgstr "आपकी कंपनी का काम, एक ही जगह"

msgid "تسويق ومستندات وفريق،"
msgstr "मार्केटिंग, दस्तावेज़ और टीम,"

msgid "كلها بذكاء في تطبيق واحد."
msgstr "सब कुछ समझदारी से, एक ही ऐप में।"

msgid ""
"يدير وكيل تسويق شركتك على وسائل التواصل، ويحفظ مستنداتها ويصدرها بورق رسمي، "
"ويترجم ويلخص ويستخرج بياناتها بالذكاء الاصطناعي، وينظم بريد فريقها ومهامه. "
"تدفع حسب ما تستهلك فقط."
msgstr ""
"वकील आपकी कंपनी की सोशल मीडिया मार्केटिंग चलाता है, उसके दस्तावेज़ सहेजता है और "
"आधिकारिक लेटरहेड पर जारी करता है, AI से अनुवाद, सारांश और डेटा निकालने का काम करता "
"है, और आपकी टीम की मेल व कामों को व्यवस्थित करता है। आप सिर्फ़ उतना भुगतान करते हैं "
"जितना उपयोग करते हैं।"

msgid "التسويق الذكي"
msgstr "स्मार्ट मार्केटिंग"

msgid "خطة محتوى شهرية، ومنشورات وتصاميم بهويتك، وتقويم ونشر"
msgstr "मासिक कंटेंट योजना, आपकी पहचान में पोस्ट और डिज़ाइन, कैलेंडर और प्रकाशन"

msgid "الأوراق والمستندات"
msgstr "कागज़ात और दस्तावेज़"

msgid "مكتبة بتنبيهات الانتهاء، ومستندات صادرة بورق رسمي ورمز تحقق"
msgstr ""
"समाप्ति अलर्ट वाली लाइब्रेरी, और सत्यापन कोड के साथ आधिकारिक लेटरहेड पर जारी दस्तावेज़"

msgid "خدمات الذكاء الاصطناعي"
msgstr "AI सेवाएँ"

msgid "ترجمة وتلخيص واستخراج بيانات وقراءة المستندات"
msgstr "अनुवाद, सारांश, डेटा निष्कर्षण और दस्तावेज़ पढ़ना"

msgid "استوديو الهوية"
msgstr "पहचान स्टूडियो"

msgid "شعار وألوان وخطوط وأوراق وبطاقات لعلامتك"
msgstr "आपके ब्रांड के लिए लोगो, रंग, फ़ॉन्ट, स्टेशनरी और कार्ड"

msgid "البريد والتواصل"
msgstr "मेल और संवाद"

msgid "صندوق بريد الشركة، وإعلانات داخلية، ونماذج واستبيانات"
msgstr "कंपनी का मेलबॉक्स, आंतरिक घोषणाएँ, फ़ॉर्म और सर्वेक्षण"

msgid "مساحة الفريق ومارد"
msgstr "टीम स्थान और मारिद"

msgid "مهام وجهات اتصال وملاحظات، ومساعد يقترح ولا ينفذ إلا بموافقتك"
msgstr ""
"कार्य, संपर्क और नोट्स, और एक सहायक जो सुझाव देता है और केवल आपकी मंज़ूरी से काम करता है"

msgid "وكيل · عمل شركتك في مكان واحد"
msgstr "वकील · आपकी कंपनी का काम, एक ही जगह"

msgid "سجّل الدخول لمتابعة عمل شركتك."
msgstr "अपनी कंपनी का काम जारी रखने के लिए साइन इन करें।"

msgid "أنشئ حسابك، وبعد تفعيله تضيف شركتك وتبدأ باستخدام كل خدمات وكيل."
msgstr ""
"अपना खाता बनाएँ, और सक्रिय होने के बाद अपनी कंपनी जोड़ें और वकील की सभी सेवाओं का "
"उपयोग शुरू करें।"

msgid "آخر الحركات على الرصيد"
msgstr "बैलेंस की ताज़ा गतिविधियाँ"

msgid "إزالة التصفية"
msgstr "फ़िल्टर हटाएँ"

msgid "اعتماد المشتركين الجدد، وشحن أرصدتهم، وتعليق الشركات وحذفها"
msgstr "नए सब्सक्राइबर स्वीकृत करें, उनका बैलेंस रिचार्ज करें, कंपनियों को निलंबित करें और हटाएँ"

msgid "الحساب معلّق"
msgstr "खाता निलंबित है"

msgid "الرصيد ($)"
msgstr "बैलेंस ($)"

msgid "المبلغ ($، سالب للسحب)"
msgstr "राशि ($, निकासी के लिए ऋणात्मक)"

msgid "حساب نشط"
msgstr "सक्रिय खाता"

msgid "سجل الشحن والخصم الكامل"
msgstr "रिचार्ज और कटौती का पूरा इतिहास"

