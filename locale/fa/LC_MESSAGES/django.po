msgid "خدمات الذكاء الاصطناعي"
msgstr "خدمات هوش مصنوعی"

msgid "ترجمة وتلخيص واستخراج بيانات وقراءة المستندات"
msgstr "ترجمه، خلاصه‌سازی، استخراج داده و خواندن اسناد"

msgid "استوديو الهوية"
msgstr "استودیوی هویت"

msgid "شعار وألوان وخطوط وأوراق وبطاقات لعلامتك"
msgstr "لوگو، رنگ‌ها، فونت‌ها، اوراق اداری و کارت‌ها برای برند شما"

msgid "البريد والتواصل"
msgstr "نامه و ارتباطات"

