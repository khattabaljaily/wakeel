"ከሚመራቸው ድርጅቶች ሁሉ፣ ከመረጃቸውና ከፋይሎቻቸው ሁሉ ጋር፤ ወደ ኋላ መመለስ አይቻልም። በሌሎች ድርጅቶች ውስጥ ያለው "
"አባልነቱ ብቻ ያበቃል።"

msgid "معطّل"
msgstr "የታገደ"

msgid "معطّلة"
msgstr "የታገደች"

msgid "منح من الإدارة هذا الشهر"
msgstr "በዚህ ወር ከአስተዳደር የተሰጠ"

msgid "مهمة جديدة"
msgstr "አዲስ ተግባር"

msgid "مهمة مفتوحة لك"
msgstr "ለእርስዎ የተከፈቱ ተግባራት"

msgid "ميزانية الذكاء الاصطناعي لهذا الشهر"
msgstr "የዚህ ወር የሰው ሰራሽ አስተውሎት በጀት"

msgid ""
"نظرة شاملة على الشركات المشتركة، واستهلاك الذكاء الاصطناعي وتكلفته، وصحة "
"الخدمات."
msgstr "የተመዘገቡ ድርጅቶች፣ የሰው ሰራሽ አስተውሎት አጠቃቀምና ወጪ እንዲሁም የአገልግሎቶች ጤና አጠቃላይ እይታ።"

msgid "نقل"
msgstr "አንቀሳቅስ"

msgid "نقل إلى مشغّل"
msgstr "ወደ አስተናባሪ አንቀሳቅስ"

msgid "نقل الشركة إلى مشغّل آخر؟"
msgstr "ድርጅቱ ወደ ሌላ አስተናባሪ ይንቀሳቀስ?"

msgid "هذا آخر مشرف نظام فلا يُحذف."
msgstr "ይህ የመጨረሻው የሥርዓት አስተዳዳሪ ስለሆነ አይሰረዝም።"

msgid "ورقة في المكتبة"
msgstr "ሰነድ በቤተ-መጻሕፍት"

msgid "يزيد حسب الصفحات"
msgstr "በገጾች ብዛት ይጨምራል"

msgid "يستطيع %(email)s الدخول من جديد."
msgstr "%(email)s እንደገና መግባት ይችላል።"

msgid "يملك:"
msgstr "ባለቤት የሆነው፦"

msgid "ينتهي اشتراك الشركة بعد %(n)s يوماً."
msgstr "የድርጅቱ ምዝገባ በ%(n)s ቀናት ውስጥ ያበቃል።"

msgid ""
"— نبذة النشاط والجمهور والأسلوب والهوية البصرية، ليكتب وكيل محتوى يشبه "
"علامتك."
msgstr "— የንግዱ ማጠቃለያ፣ ታዳሚ፣ ዘይቤና ምስላዊ ማንነት፤ ዋኪል ከመለያዎ ጋር የሚመሳሰል ይዘት እንዲጽፍ።"

msgid "Your company is now served and billed by %(operator)s"
msgstr "ድርጅትዎ አሁን በ%(operator)s ይገለገላል፤ ክፍያውም በእሱ ይጠየቃል"

msgid "عمل شركتك في مكان واحد"
msgstr "የኩባንያዎ ሥራ በአንድ ቦታ"

msgid "تسويق ومستندات وفريق،"
msgstr "ግብይት፣ ሰነዶች እና ቡድን፣"

msgid "كلها بذكاء في تطبيق واحد."
msgstr "ሁሉም በብልሃት በአንድ መተግበሪያ።"

msgid ""
"يدير وكيل تسويق شركتك على وسائل التواصل، ويحفظ مستنداتها ويصدرها بورق رسمي، "
"ويترجم ويلخص ويستخرج بياناتها بالذكاء الاصطناعي، وينظم بريد فريقها ومهامه. "
"تدفع حسب ما تستهلك فقط."
msgstr ""
"ዋኪል የኩባንያዎን የማኅበራዊ ሚዲያ ግብይት ያስተዳድራል፣ ሰነዶቹን ያስቀምጣል እና በይፋዊ ደብዳቤ ራስጌ ያወጣል፣ በሰው "
"ሠራሽ ብልህነት ይተረጉማል፣ ያጠቃልላል እና ውሂባቸውን ያወጣል፣ የቡድንዎን ደብዳቤና ተግባራት ያደራጃል። የሚከፍሉት "
"ለሚጠቀሙት ብቻ ነው።"

msgid "التسويق الذكي"
msgstr "ብልህ ግብይት"

msgid "خطة محتوى شهرية، ومنشورات وتصاميم بهويتك، وتقويم ونشر"
msgstr "ወርሃዊ የይዘት ዕቅድ፣ በእርስዎ ማንነት የተነደፉ ልጥፎችና ንድፎች፣ የቀን መቁጠሪያና ሕትመት"

msgid "الأوراق والمستندات"
msgstr "ወረቀቶችና ሰነዶች"

msgid "مكتبة بتنبيهات الانتهاء، ومستندات صادرة بورق رسمي ورمز تحقق"
msgstr "የማብቂያ ማሳሰቢያ ያለው ቤተ-መጻሕፍት፣ እና በይፋዊ ደብዳቤ ራስጌና በማረጋገጫ ኮድ የሚወጡ ሰነዶች"

msgid "خدمات الذكاء الاصطناعي"
msgstr "የሰው ሠራሽ ብልህነት አገልግሎቶች"

msgid "ترجمة وتلخيص واستخراج بيانات وقراءة المستندات"
msgstr "ትርጉም፣ ማጠቃለያ፣ ውሂብ ማውጣት እና ሰነድ ማንበብ"

msgid "استوديو الهوية"
msgstr "የማንነት ስቱዲዮ"

msgid "شعار وألوان وخطوط وأوراق وبطاقات لعلامتك"
msgstr "ለምልክትዎ አርማ፣ ቀለሞች፣ ፊደላት፣ የጽሕፈት ወረቀቶችና ካርዶች"

msgid "البريد والتواصل"
msgstr "ደብዳቤና ግንኙነት"

msgid "صندوق بريد الشركة، وإعلانات داخلية، ونماذج واستبيانات"
msgstr "የኩባንያ የደብዳቤ ሳጥን፣ ውስጣዊ ማስታወቂያዎች፣ ቅጾችና የዳሰሳ ጥናቶች"

msgid "مساحة الفريق ومارد"
msgstr "የቡድን ቦታና ማሪድ"

msgid "مهام وجهات اتصال وملاحظات، ومساعد يقترح ولا ينفذ إلا بموافقتك"
msgstr "ተግባራት፣ እውቂያዎችና ማስታወሻዎች፣ እና የሚጠቁም ነገር ግን በእርስዎ ፈቃድ ብቻ የሚሠራ ረዳት"

msgid "وكيل · عمل شركتك في مكان واحد"
msgstr "ዋኪል · የኩባንያዎ ሥራ በአንድ ቦታ"

msgid "سجّل الدخول لمتابعة عمل شركتك."
msgstr "የኩባንያዎን ሥራ ለመቀጠል ይግቡ።"

msgid "أنشئ حسابك، وبعد تفعيله تضيف شركتك وتبدأ باستخدام كل خدمات وكيل."
msgstr "መለያዎን ይፍጠሩ፤ ከነቃ በኋላ ኩባንያዎን ጨምረው ሁሉንም የዋኪል አገልግሎቶች መጠቀም ይጀምራሉ።"

msgid "آخر الحركات على الرصيد"
msgstr "የቅርብ ጊዜ የቀሪ ሂሳብ እንቅስቃሴዎች"

msgid "إزالة التصفية"
msgstr "ማጣሪያውን አስወግድ"

msgid "اعتماد المشتركين الجدد، وشحن أرصدتهم، وتعليق الشركات وحذفها"
msgstr "አዳዲስ ተመዝጋቢዎችን ማጽደቅ፣ ቀሪ ሂሳባቸውን መሙላት፣ ኩባንያዎችን ማገድና መሰረዝ"

msgid "الحساب معلّق"
msgstr "መለያው ታግዷል"

msgid "الرصيد ($)"
msgstr "ቀሪ ሂሳብ ($)"

msgid "المبلغ ($، سالب للسحب)"
msgstr "መጠን ($፣ ለማውጣት አሉታዊ)"

msgid "حساب نشط"
msgstr "ንቁ መለያ"

msgid "سجل الشحن والخصم الكامل"
msgstr "የሙሉ ሂሳብ መሙላትና ቅነሳ ታሪክ"

msgid "شحن الرصيد"
msgstr "ቀሪ ሂሳብ ሙላ"

msgid "شحن رصيد"
msgstr "የሚከተለውን ቀሪ ሂሳብ ሙላ፦"

msgid "شحن رصيد %(name)s"
msgstr "የ%(name)s ቀሪ ሂሳብ ሙላ"

