msgstr "ለምሳሌ፦ የባንክ ዝውውር ቁጥር …"

msgid "ملاحظة (تظهر في السجل)"
msgstr "ማስታወሻ (በመዝገቡ ውስጥ ይታያል)"

msgid "يدوياً (بعد استلام الدفع، أو منحة). الرصيد الحالي:"
msgstr "በእጅ (ክፍያ ከተቀበሉ በኋላ ወይም እንደ ስጦታ)። አሁን ያለው ቀሪ ሂሳብ፦"

msgid "يُسجَّل في سجل المحافظ."
msgstr "በቦርሳ መዝገብ ውስጥ ይመዘገባል።"

msgid ""
"ستُحذف الشركة وخططها ومنشوراتها وصورها وكل بياناتها، ولا يمكن التراجع عن ذلك. "
"حسابات أعضائها تبقى."
msgstr "ኩባንያው፣ ዕቅዶቹ፣ ልጥፎቹ፣ ምስሎቹና ሁሉም ውሂቡ ለዘላለም ይሰረዛሉ። የአባላቱ መለያዎች ይቀራሉ።"

msgid ""
"لن يتمكن فريق الشركة من العمل، ويتوقف النشر التلقائي ورابط العميل حتى تعيد "
"تنشيطه. البيانات تبقى كما هي."
msgstr ""
"የኩባንያው ቡድን መሥራት አይችልም፤ እስኪያነቃቁት ድረስ ራስ-ሰር ህትመትና የደንበኛ አገናኝ ይቆማሉ። ውሂቡ እንዳለ "
"ይቆያል።"

msgid "Added this month"
msgstr "በዚህ ወር የታከለ"

msgid "Used this month"
msgstr "በዚህ ወር የተጠቀሙት"

msgid "Paid services run"
msgstr "የተከናወኑ የክፍያ አገልግሎቶች"

msgid "The balance is low. Top it up to keep using the paid services."
msgstr "ቀሪ ሂሳቡ ዝቅተኛ ነው። የክፍያ አገልግሎቶችን መጠቀም ለመቀጠል ይሙሉት።"

msgid "%(points)s points"
msgstr "%(points)s ነጥቦች"

msgid "Pay by card"
msgstr "በካርድ ይክፈሉ"

msgid "Search a service"
msgstr "አገልግሎት ይፈልጉ"

msgid "No service matches."
msgstr "ምንም የሚዛመድ አገልግሎት የለም።"

msgid "Added"
msgstr "የታከለ"

msgid "Charges"
msgstr "ክፍያዎች"

msgid "ربط فيسبوك وإنستغرام قريباً"
msgstr "ፌስቡክ እና ኢንስታግራምን ማገናኘት በቅርቡ ይመጣል"

msgid ""
"الخدمة قيد الاعتماد لدى Meta ولم تُفتح بعد، وستكون متاحة قريباً. يمكنك الآن "
"ربط تيك توك والنشر عليه."
msgstr ""
"አገልግሎቱ በMeta እየተገመገመ ነው፤ እስካሁን አልተከፈተም፤ በቅርቡ ይገኛል። አሁን ቲክቶክን ማገናኘት እና ወደዚያ "
"መለጠፍ ይችላሉ።"

msgid "قريباً"
msgstr "በቅርቡ"

msgid "انشر بنفسك في دقيقة"
msgstr "በአንድ ደቂቃ ውስጥ በራስዎ ያትሙ"

msgid "انسخ النص وافتح %(label)s"
msgstr "ጽሑፉን ቅዳ እና %(label)s ክፈት"

msgid "مشاركة من الجوال (نص وصورة)"
msgstr "ከስልክ አጋራ (ጽሑፍ እና ምስል)"

msgid "الصق النص في الصفحة التي تفتح، ثم أضف الصورة:"
msgstr "በሚከፈተው ገጽ ላይ ጽሑፉን ለጥፉ፣ ከዚያ ምስሉን ያክሉ፦"

msgid "انسخ الصورة (للصقها مباشرة)"
msgstr "ምስሉን ቅዳ (በቀጥታ ለመለጠፍ)"

msgid "نزّل الصورة"
msgstr "ምስሉን አውርድ"

msgid "انسخ النص فقط"
msgstr "ጽሑፉን ብቻ ቅዳ"

msgid "موعده المقترح:"
msgstr "የተጠቆመ ሰዓት፦"

msgid "(اختر «جدولة» في Business Suite لنشره في موعده)."
msgstr "(በዚያ ሰዓት ለማተም በ Business Suite ውስጥ «መርሐ ግብር» ይምረጡ)።"

msgid ""
"قريباً: النشر المباشر على فيسبوك وإنستغرام سيكون مؤتمتاً بالكامل، فيُنشر "
